{
  "items": [
    {
      "id": "fact_list_hi_001",
      "type": "fact_card",
      "title": "आँखों की भाषा सीखो",
      "language": "hi",
      "facts": [
        {
          "text": "जो आपकी आँखों में देखकर बात करे, वो सच में \"ईमानदार\" है।",
          "highlight": "ईमानदार"
        },
        {
          "text": "पुतलियाँ अचानक बड़ी हों तो समझो आपमें उसकी \"रुचि\" बढ़ गई है।",
          "highlight": "रुचि"
        },
        {
          "text": "बार-बार पलकें झपकाना \"बेचैनी\", \"झूठ\" या \"छुपाव\" का संकेत है।",
          "highlight": "बेचैनी"
        },
        {
          "text": "बात करते समय नज़रें बार-बार नीचे जाना \"शर्म\" या \"अपराधबोध\" दिखाता है।",
          "highlight": "अपराधबोध"
        },
        {
          "text": "ऊपर दाईं तरफ देखना \"रचना\" है, ऊपर बाईं तरफ \"याद\" है।",
          "highlight": "याद"
        }
      ],
      "tags": ["body_language", "eyes", "psychology", "hindi"],
      "points": 0,
      "topic": "body_language",
      "source_name": "Traditional body language wisdom"
    },
    {
      "id": "fact_list_hi_002",
      "type": "fact_card",
      "title": "हाथों के राज़",
      "language": "hi",
      "facts": [
        {
          "text": "खुले हाथ \"ईमानदारी\" और \"विश्वास\" की निशानी हैं।",
          "highlight": "ईमानदारी"
        },
        {
          "text": "हाथ जेब में छुपाना \"कुछ छुपाने\" या \"असहजता\" का संकेत है।",
          "highlight": "असहजता"
        },
        {
          "text": "उँगलियाँ चटकाना दिखावटी \"आत्मविश्वास\" की पहचान है।",
          "highlight": "आत्मविश्वास"
        },
        {
          "text": "गर्दन पीछे हाथ रखना \"शक्ति\" और \"प्रभुत्व\" दिखाता है।",
          "highlight": "शक्ति"
        },
        {
          "text": "हाथ मिलाते समय ऊपर खींचे तो \"कंट्रोल\" चाहता है वो।",
          "highlight": "कंट्रोल"
        }
      ],
      "tags": ["body_language", "hands", "psychology", "hindi"],
      "points": 0,
      "topic": "body_language",
      "source_name": "Traditional body language wisdom"
    },
    {
      "id": "fact_list_hi_003",
      "type": "fact_card",
      "title": "चेहरे के भाव पढ़ो",
      "language": "hi",
      "facts": [
        {
          "text": "असली हँसी \"आँखों\" से शुरू होती है, नकली सिर्फ \"होंठों\" तक रहती है।",
          "highlight": "आँखों"
        },
        {
          "text": "माथे पर हाथ रखना \"उलझन\", \"परेशानी\" या \"भूलने\" का संकेत है।",
          "highlight": "उलझन"
        },
        {
          "text": "नाक छूना \"अस्वीकृति\", \"शंका\" या \"असहमति\" दिखाता है।",
          "highlight": "शंका"
        },
        {
          "text": "होंठ काटना \"बेचैनी\", \"डर\" या \"आत्मविश्वास की कमी\" दिखाता है।",
          "highlight": "डर"
        },
        {
          "text": "भौंहें 1-2 सेकंड ऊपर उठना \"झूठ\" या \"अचरज\" की पहचान है।",
          "highlight": "झूठ"
        }
      ],
      "tags": ["body_language", "face", "expressions", "hindi"],
      "points": 0,
      "topic": "body_language",
      "source_name": "Traditional body language wisdom"
    },
    {
      "id": "fact_list_hi_004",
      "type": "fact_card",
      "title": "शरीर की मुद्रा का रहस्य",
      "language": "hi",
      "facts": [
        {
          "text": "सीधे कंधों के साथ खड़ा होना \"आत्मविश्वास\" और \"मजबूती\" दिखाता है।",
          "highlight": "मजबूती"
        },
        {
          "text": "कंधे झुकाना \"थकान\", \"हार\" या \"उदासी\" का संकेत है।",
          "highlight": "उदासी"
        },
        {
          "text": "पैर चौड़े करके खड़ा होना \"ताकत\" और \"प्रभुत्व\" जताता है।",
          "highlight": "प्रभुत्व"
        },
        {
          "text": "बैठे-बैठे पैर हिलाना \"बेचैनी\" या \"जाने की जल्दी\" बताता है।",
          "highlight": "बेचैनी"
        },
        {
          "text": "दीवार से टिककर खड़ा होना \"थकान\" या \"असहजता\" दिखाता है।",
          "highlight": "थकान"
        }
      ],
      "tags": ["body_language", "posture", "psychology", "hindi"],
      "points": 0,
      "topic": "body_language",
      "source_name": "Traditional body language wisdom"
    },
    {
      "id": "fact_list_hi_005",
      "type": "fact_card",
      "title": "पैर बोलते हैं सबसे ज़्यादा",
      "language": "hi",
      "facts": [
        {
          "text": "पैर जिस तरफ हों, \"रुचि\" और \"ध्यान\" उसी तरफ है।",
          "highlight": "ध्यान"
        },
        {
          "text": "पैर बार-बार हिलाना \"बेचैनी\", \"ऊब\" या \"जाने की इच्छा\" दिखाता है।",
          "highlight": "ऊब"
        },
        {
          "text": "पैर अंदर की तरफ रखना \"आत्मविश्वास की कमी\" या \"डर\" दिखाता है।",
          "highlight": "डर"
        },
        {
          "text": "पंजों पर खड़ा होना \"उत्सुकता\" या \"उत्तेजना\" का संकेत है।",
          "highlight": "उत्तेजना"
        },
        {
          "text": "पैर क्रॉस करके बैठना \"बंद रवैया\" या \"आराम\" दिखाता है।",
          "highlight": "बंद रवैया"
        }
      ],
      "tags": ["body_language", "feet", "psychology", "hindi"],
      "points": 0,
      "topic": "body_language",
      "source_name": "Traditional body language wisdom"
    },
    {
      "id": "fact_list_hi_006",
      "type": "fact_card",
      "title": "हाथ मिलाने का विज्ञान",
      "language": "hi",
      "facts": [
        {
          "text": "मजबूत और सीधा \"हाथ\" मिलाना \"विश्वसनीयता\" और \"ईमानदारी\" दिखाता है।",
          "highlight": "ईमानदारी"
        },
        {
          "text": "कमज़ोर हाथ मिलाना \"डर\", \"हीनभावना\" या \"कमज़ोर इरादे\" बताता है।",
          "highlight": "हीनभावना"
        },
        {
          "text": "हाथ को अपनी तरफ खींचना \"कंट्रोल\" और \"प्रभुत्व\" की भावना है।",
          "highlight": "प्रभुत्व"
        },
        {
          "text": "हाथ को दूसरे की तरफ झुकाना \"विनम्रता\" या \"अधीनता\" दिखाता है।",
          "highlight": "विनम्रता"
        },
        {
          "text": "दोनों हाथों से मिलाना \"दिखावटी प्रेम\" या \"असली सम्मान\" का संकेत है।",
          "highlight": "सम्मान"
        }
      ],
      "tags": ["body_language", "handshake", "psychology", "hindi"],
      "points": 0,
      "topic": "body_language",
      "source_name": "Traditional body language wisdom"
    },
    {
      "id": "fact_list_hi_007",
      "type": "fact_card",
      "title": "आवाज़ में छुपा राज़",
      "language": "hi",
      "facts": [
        {
          "text": "तेज़ और ऊँची आवाज़ \"आत्मविश्वास\" या \"गुस्से\" की निशानी है।",
          "highlight": "गुस्सा"
        },
        {
          "text": "धीमी आवाज़ \"रहस्य\", \"डर\" या \"आत्मविश्वास की कमी\" दिखाती है।",
          "highlight": "रहस्य"
        },
        {
          "text": "बार-बार गला साफ़ करना \"झूठ\" या \"बेचैनी\" का पक्का संकेत है।",
          "highlight": "झूठ"
        },
        {
          "text": "बहुत तेज़ बोलना \"बेचैनी\" या \"बहानेबाज़ी\" की पहचान है।",
          "highlight": "बहानेबाज़ी"
        },
        {
          "text": "आवाज़ का ऊपर-नीचे जाना \"उत्तेजना\" या \"झूठ\" दोनों हो सकता है।",
          "highlight": "उत्तेजना"
        }
      ],
      "tags": ["body_language", "voice", "psychology", "hindi"],
      "points": 0,
      "topic": "body_language",
      "source_name": "Traditional body language wisdom"
    },
    {
      "id": "fact_list_hi_008",
      "type": "fact_card",
      "title": "माइक्रो एक्सप्रेशन के रहस्य",
      "language": "hi",
      "facts": [
        {
          "text": "इंसान का असली चेहरा सिर्फ \"1/25 सेकंड\" के लिए दिखता है।",
          "highlight": "1/25 सेकंड"
        },
        {
          "text": "असली मुस्कान 1 सेकंड से ज़्यादा \"रहती\" है, नकली जल्दी \"बुझ\" जाती है।",
          "highlight": "बुझ"
        },
        {
          "text": "एक तरफ का होंट खींचना \"घृणा\" या \"अस्वीकृति\" दिखाता है।",
          "highlight": "घृणा"
        },
        {
          "text": "नाक की हल्की सिकुड़न \"असहमति\" या \"शंका\" की पहचान है।",
          "highlight": "असहमति"
        },
        {
          "text": "आँख का सिकुड़ना \"गुस्सा\", \"शंका\" या \"ध्यान\" का सूक्ष्म संकेत है।",
          "highlight": "ध्यान"
        }
      ],
      "tags": ["psychology", "micro_expressions", "hindi"],
      "points": 0,
      "topic": "psychology",
      "source_name": "Traditional body language wisdom"
    },
    {
      "id": "fact_list_hi_009",
      "type": "fact_card",
      "title": "दूरी और स्पर्श की भाषा",
      "language": "hi",
      "facts": [
        {
          "text": "18 इंच से कम दूरी \"अंतरंगता\" और \"प्यार\" की निशानी है।",
          "highlight": "अंतरंगता"
        },
        {
          "text": "4 फीट की दूरी \"दोस्ती\" और \"आराम\" की पहचान है।",
          "highlight": "दोस्ती"
        },
        {
          "text": "12 फीट से ज़्यादा दूरी \"अजनबी\" या \"औपचारिकता\" दिखाती है।",
          "highlight": "अजनबी"
        },
        {
          "text": "कंधे पर हाथ रखना \"दोस्ती\", \"सहारा\" या \"भरोसा\" दिखाता है।",
          "highlight": "भरोसा"
        },
        {
          "text": "पीठ पर थपकी \"प्रोत्साहन\" और \"स्नेह\" की निशानी है।",
          "highlight": "स्नेह"
        }
      ],
      "tags": ["body_language", "space", "touch", "hindi"],
      "points": 0,
      "topic": "body_language",
      "source_name": "Traditional body language wisdom"
    },
    {
      "id": "fact_list_hi_010",
      "type": "fact_card",
      "title": "मिररिंग और जुड़ाव",
      "language": "hi",
      "facts": [
        {
          "text": "जो आपकी \"नकल\" करे, वो आपसे \"प्यार\" या \"जुड़ाव\" रखता है।",
          "highlight": "नकल"
        },
        {
          "text": "एक जैसे बैठना \"सहमति\", \"जुड़ाव\" और \"तालमेल\" दिखाता है।",
          "highlight": "तालमेल"
        },
        {
          "text": "एक साथ \"हँसना\" दो लोगों के बीच गहरे \"जुड़ाव\" की निशानी है।",
          "highlight": "जुड़ाव"
        },
        {
          "text": "आपकी बातों की शैली अपनाना \"सम्मान\" या \"प्रेम\" दिखाता है।",
          "highlight": "प्रेम"
        },
        {
          "text": "दर्पण व्यवहार \"सहानुभूति\", \"समझ\" और \"अपनापन\" का संकेत है।",
          "highlight": "अपनापन"
        }
      ],
      "tags": ["psychology", "mirroring", "relationships", "hindi"],
      "points": 0,
      "topic": "psychology",
      "source_name": "Traditional body language wisdom"
    },
    {
      "id": "fact_list_hi_011",
      "type": "fact_card",
      "title": "झूठ पहचानो पल भर में",
      "language": "hi",
      "facts": [
        {"text": "झूठ बोलते वक़्त नाक \"फड़कती\" है, गौर से देखो।", "highlight": "फड़कती"},
        {"text": "झूठा इंसान \"आँखें\" ज़्यादा झपकाता है।", "highlight": "आँखें"},
        {"text": "\"बहुत\" विस्तार से बताना झूठ का \"बचाव\" है।", "highlight": "बचाव"},
        {"text": "झूठ बोलते वक़्त गला \"सूख\" जाता है।", "highlight": "सूख"},
        {"text": "झूठा \"मुस्कुरा\" कर बात \"ख़त्म\" करना चाहता है।", "highlight": "ख़त्म"}
      ],
      "tags": ["lie_detection", "psychology", "hindi"],
      "points": 0,
      "topic": "lie_detection",
      "source_name": "Traditional psychology wisdom"
    },
    {
      "id": "fact_list_hi_012",
      "type": "fact_card",
      "title": "प्यार के अनकहे इशारे",
      "language": "hi",
      "facts": [
        {"text": "जो \"बात\" करने का \"बहाना\" ढूँढे, वो \"प्यार\" करता है।", "highlight": "प्यार"},
        {"text": "आपको \"याद\" करके मैसेज करना \"प्रेम\" की निशानी है।", "highlight": "प्रेम"},
        {"text": "\"आँखों\" में चमक असली \"प्यार\" की पहचान है।", "highlight": "प्यार"},
        {"text": "\"छोटी\" चीज़ों पर \"ध्यान\" देना सच्चे प्यार की निशानी है।", "highlight": "ध्यान"},
        {"text": "आपकी \"बात\" याद रखने वाला \"प्यार\" करता है।", "highlight": "प्यार"}
      ],
      "tags": ["love", "relationships", "hindi"],
      "points": 0,
      "topic": "love",
      "source_name": "Traditional psychology wisdom"
    },
    {
      "id": "fact_list_hi_013",
      "type": "fact_card",
      "title": "धोखेबाज़ की पहचान",
      "language": "hi",
      "facts": [
        {"text": "\"बहुत\" अच्छा बोलने वाला अंदर से \"धोखेबाज़\" होता है।", "highlight": "धोखेबाज़"},
        {"text": "\"कसमें\" खाकर \"भरोसा\" माँगने वाले से सावधान रहो।", "highlight": "भरोसा"},
        {"text": "\"फ़ायदा\" पहुँचाने वाला पहले \"नुकसान\" पहुँचाता है।", "highlight": "नुकसान"},
        {"text": "\"रहस्यमयी\" इंसान से हमेशा \"दूरी\" बनाए रखो।", "highlight": "दूरी"},
        {"text": "\"आँसू\" दिखाकर \"माफी\" माँगने वाला फिर वही गलती करेगा।", "highlight": "माफी"}
      ],
      "tags": ["fraud", "psychology", "hindi"],
      "points": 0,
      "topic": "fraud_detection",
      "source_name": "Traditional psychology wisdom"
    },
    {
      "id": "fact_list_hi_014",
      "type": "fact_card",
      "title": "गुस्से के छुपे लक्षण",
      "language": "hi",
      "facts": [
        {"text": "\"नाक\" के पंख फड़कना \"गुस्से\" की पहली निशानी है।", "highlight": "गुस्से"},
        {"text": "\"जबड़ा\" भिंचना \"दबा हुआ\" क्रोध दिखाता है।", "highlight": "क्रोध"},
        {"text": "\"आँखें\" छोटी होना \"क्रोध\" का स्पष्ट संकेत है।", "highlight": "क्रोध"},
        {"text": "\"मुट्ठी\" भींचना \"हिंसक\" विचारों की पहचान है।", "highlight": "हिंसक"},
        {"text": "\"साँसें\" भारी होना \"दबा\" गुस्सा दिखाता है।", "highlight": "दबा"}
      ],
      "tags": ["anger", "emotions", "hindi"],
      "points": 0,
      "topic": "emotions",
      "source_name": "Traditional psychology wisdom"
    },
    {
      "id": "fact_list_hi_015",
      "type": "fact_card",
      "title": "डर के सूक्ष्म संकेत",
      "language": "hi",
      "facts": [
        {"text": "\"पलकें\" तेज़ झपकना \"डर\" या \"चिंता\" की निशानी है।", "highlight": "डर"},
        {"text": "\"हाथ\" काँपना \"भय\" या \"ठंड\" का संकेत है।", "highlight": "भय"},
        {"text": "\"साँसें\" तेज़ चलना \"भय\" या \"घबराहट\" दिखाता है।", "highlight": "घबराहट"},
        {"text": "\"शरीर\" पीछे खींचना \"असुरक्षा\" की भावना है।", "highlight": "असुरक्षा"},
        {"text": "\"आवाज़\" काँपना \"डर\" या \"रोमांच\" दोनों हो सकता है।", "highlight": "रोमांच"}
      ],
      "tags": ["fear", "emotions", "hindi"],
      "points": 0,
